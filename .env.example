# =================================================================
# AI Mystery Room - Production Environment Configuration Reference
# =================================================================

# Server Port (Auto-assigned by cloud hosts such as Render / Railway / Heroku)
PORT=5000

# Node Environment ('production' for live deployment)
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas cluster with write permissions)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_mystery_room?retryWrites=true&w=majority
MONGODB_URI=

# Strong random secret string used to sign JWT authentication tokens
# You can generate one via: openssl rand -base64 32
JWT_SECRET=

# Google Gemini AI API Key (Get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Supported Google Gemini Model identifier
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL (Used for CORS validation when frontend is deployed on Vercel or Netlify)
# Example: https://ai-mystery-room.vercel.app
CLIENT_URL=http://localhost:5173
