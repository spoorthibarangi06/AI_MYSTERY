# AI Mystery Room - Environment Configuration Template

# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/ai_mystery_room

# JWT Signing Secret
JWT_SECRET=detective_mystery_secret_key_2026_jwt

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model identifier
GEMINI_MODEL=gemini-1.5-flash

# Client Web Application URL
CLIENT_URL=http://localhost:5173

# Optional Cloud Asset Storage
ASSET_STORAGE_URL=
ASSET_STORAGE_SECRET=
