{
  "name": "ai-mystery-room",
  "version": "1.0.0",
  "description": "AI-Powered Interactive Mystery Investigation Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "start": "npm run dev",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "install:all": "npm install --prefix server && npm install --prefix client"
  },
  "keywords": [
    "ai",
    "mystery",
    "detective",
    "gemini",
    "react",
    "vite",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
